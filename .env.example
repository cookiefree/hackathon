# WebUntis login. Server is the host only, e.g. mese.webuntis.com
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=
UNTIS_CLIENT=hackathon

# Telegram bot (create with @BotFather). Only one machine should run the bot at a time.
TELEGRAM_TOKEN=
ALLOWED_USERS=                  # comma-separated numeric Telegram IDs; empty = nobody can upload. Ask the bot /whoami.
# TELEGRAM_ENABLED=0            # set to 0 to run the web app without starting the bot
