# WebUntis login. Server is the host only, e.g. mese.webuntis.com
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=
UNTIS_CLIENT=hackathon
# UNTIS_PROVIDER=mock         # real | mock (default mock)

# LLM for lesson notes: stub (default, keyword heuristics, free) | llamacpp (local llama-server)
LLM_PROVIDER=stub
# llamacpp: start the server first with C:\llm\run-server.ps1 (one request at a time, 32k context).
# Note: config.py uses setdefault, so a real environment variable overrides this file, e.g.
#   $env:LLM_PROVIDER = "llamacpp"   (PowerShell)
LLAMACPP_URL=http://127.0.0.1:8080
LLAMACPP_TIMEOUT=180            # seconds per request; a 10k-token transcript takes 40-45 s
# LLAMACPP_MAX_TOKENS=2048      # cap on the model's answer
