# WebUntis login. Server is the host only, e.g. mese.webuntis.com
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=
UNTIS_CLIENT=hackathon
UNTIS_PROVIDER=real             # real | mock (demo, password 'demo'). Must be set; if it is not, login is disabled

# Telegram bot (create with @BotFather). Only one machine should run the bot at a time.
TELEGRAM_TOKEN=
ALLOWED_USERS=                  # admin Telegram IDs, comma-separated. They create invites with /invite. Ask the bot /whoami.
# TELEGRAM_ENABLED=0            # set to 0 to run the web app without starting the bot
# MAX_UPLOADS_PER_USER=500      # upload cap per person

# Untis alerts (Entfall, substitutions, room changes, new homework), sent to the admin. OFF by default.
# This checks the account in UNTIS_USER / UNTIS_PASSWORD above every few minutes, so it needs UNTIS_PROVIDER=real.
# ALERTS=on
# ALERT_MINUTES=10
# ALERT_TELEGRAM_ID=             # who gets them (default: the first ID in ALLOWED_USERS)

# Reading text from photos. Off by default: with gemini, every photo is sent to Google.
# Check your key's tier first: on the free tier Google may use content to improve its products.
# OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # gemini-2.5-flash is closed to new keys
# GEMINI_TIMEOUT=60                     # seconds to wait for one photo
